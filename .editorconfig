root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

[*.{js,cjs,css,html,json}]
indent_size = 2

[*.{csproj,props,xml}]
indent_size = 4

[*.ps1]
indent_size = 4
